# Local development only. Do not add real Telegram/provider credentials here.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=https://app.example.com
API_URL=https://api.example.com
WS_URL=wss://api.example.com
DATABASE_URL=postgresql://watchroom:watchroom@localhost:5432/watchroom
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
HTTP_BODY_LIMIT_BYTES=65536
METRICS_BEARER_TOKEN=
OPERATIONS_BEARER_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TWITCH_PARENT_DOMAINS=localhost
WATCHROOM_DEPLOYMENT=local
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PROVIDER_METADATA_TTL_SECONDS=900
PROVIDER_METADATA_RATE_LIMIT_PER_MINUTE=20
REALTIME_HEARTBEAT_TIMEOUT_MS=45000
REALTIME_PRESENCE_GRACE_MS=8000
CHAT_CLEANUP_INTERVAL_MS=60000
CREATE_ROOM_RATE_LIMIT_PER_HOUR=10
SOURCE_CHANGE_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=20
REACTION_RATE_LIMIT_PER_MINUTE=60
ABUSE_REPORT_RATE_LIMIT_PER_DAY=5
API_INTERNAL_URL=http://localhost:4000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=30
SESSION_TTL_SECONDS=43200
ROOM_GRANT_TTL_SECONDS=14400
TELEGRAM_BOT_USERNAME=watchroom_bot
TELEGRAM_APP_SHORT_NAME=watchroom
# Explicit local-only switch. It is rejected when NODE_ENV=production.
MOCK_TELEGRAM_AUTH=false
MOCK_TELEGRAM_ID=900000001
MOCK_TELEGRAM_FIRST_NAME=Локальный автор
