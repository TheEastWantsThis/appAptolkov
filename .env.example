# Локальная PostgreSQL из docker-compose.yml
DATABASE_URL="postgresql://apotolkov:apotolkov_dev@localhost:5432/apotolkov?schema=public"

# Сгенерируйте: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUST_HOST="true"

# Используются только командой npm run db:seed. Не применяйте эти значения в production.
SEED_ADMIN_PASSWORD="Adm001"
SEED_DEMO_PASSWORD="Dem001"
