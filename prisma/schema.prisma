generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum LeadSource {
  PROMOTER
  WEBSITE
  PHONE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  QUALIFIED
  DECLINED
  CONVERTED
}

enum HousingType {
  APARTMENT
  HOUSE
  COMMERCIAL
  NEW_BUILD
  OTHER
}

enum CallResult {
  NO_ANSWER
  CALLBACK
  INTERESTED
  MEASUREMENT
  DECLINED
  WRONG_NUMBER
}

enum WorkTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkTaskType {
  CALL
  FOLLOW_UP
  MEASUREMENT
  GENERAL
}

enum ProjectStatus {
  QUALIFIED
  MEASUREMENT_SCHEDULED
  MEASURED
  ESTIMATE_PREPARATION
  CONTRACT_PENDING
  CONTRACT_SIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CalendarEventType {
  CALL
  MEASUREMENT
  MEETING
  INSTALLATION
  DEADLINE
  OTHER
}

enum MeasurementStatus {
  SCHEDULED
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AreaCalculationMode {
  AUTO
  MANUAL
}

enum RoomMediaType {
  PHOTO
  DRAWING
}

enum TariffUnit {
  M2
  M
  PCS
  FIXED
  ZONE
  COEFFICIENT
}

enum EstimateStatus {
  DRAFT
  FINAL
  CANCELLED
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  email                String                     @unique @db.VarChar(254)
  emailVerified        DateTime?
  login                String                     @unique @db.VarChar(64)
  name                 String                     @db.VarChar(160)
  image                String?
  passwordHash         String
  isActive             Boolean                    @default(true)
  blockedAt            DateTime?
  blockedReason        String?                    @db.VarChar(500)
  mustChangePassword   Boolean                    @default(false)
  passwordChangedAt    DateTime                   @default(now())
  lastLoginAt          DateTime?
  sessionVersion       Int                        @default(1)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  archivedAt           DateTime?
  accounts             Account[]
  sessions             Session[]
  roles                UserRole[]                 @relation("UserRoles")
  assignedRoles        UserRole[]                 @relation("RoleAssignedBy")
  permissionOverrides  UserPermission[]           @relation("UserPermissions")
  assignedPermissions  UserPermission[]           @relation("PermissionAssignedBy")
  auditLogs            AuditLog[]                 @relation("AuditActor")
  authoredLeads        Lead[]                     @relation("LeadAuthor")
  operatedLeads        Lead[]                     @relation("LeadOperator")
  measuredLeads        Lead[]                     @relation("LeadMeasurer")
  callLogs             CallLog[]                  @relation("CallAuthor")
  assignedTasks        WorkTask[]                 @relation("TaskAssignee")
  createdTasks         WorkTask[]                 @relation("TaskAuthor")
  createdProjects      Project[]                  @relation("ProjectCreator")
  projectAssignments   ProjectResponsible[]
  projectComments      ProjectComment[]
  uploadedFiles        ProjectFile[]
  statusChanges        ProjectStatusHistory[]
  assignmentChanges    ProjectAssignmentHistory[] @relation("AssignmentChangedBy")
  assignedInHistory    ProjectAssignmentHistory[] @relation("AssignmentUser")
  calendarEvents       CalendarEvent[]            @relation("EventAssignee")
  assignedMeasurements Measurement[]              @relation("MeasurementMeasurer")
  authoredEstimates    Estimate[]                 @relation("EstimateAuthor")
  updatedTariffs       Tariff[]                   @relation("TariffUpdatedBy")
  uploadedRoomMedia    ProjectRoomMedia[]         @relation("RoomMediaUploader")

  @@index([isActive, archivedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@index([isActive])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  category    String           @db.VarChar(64)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  users       UserPermission[]

  @@index([category])
  @@map("permissions")
}

model UserRole {
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?
  user         User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  assignedById String?          @db.Uuid
  reason       String?          @db.VarChar(500)
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation("UserPermissions", fields: [userId], references: [id], onDelete: Restrict)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  assignedBy   User?            @relation("PermissionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([expiresAt])
  @@map("user_permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  summary    String   @db.VarChar(500)
  beforeData Json?
  afterData  Json?
  metadata   Json?
  requestId  String?  @db.VarChar(100)
  ipHash     String?  @db.VarChar(128)
  userAgent  String?  @db.VarChar(500)
  occurredAt DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model Lead {
  id                String       @id @default(uuid()) @db.Uuid
  clientName        String?      @db.VarChar(160)
  phone             String       @db.VarChar(32)
  phoneNormalized   String       @unique @db.VarChar(20)
  districtOrAddress String?      @db.VarChar(500)
  housingType       HousingType?
  roomsApprox       Int?
  repairTimeline    String?      @db.VarChar(160)
  preferredCallTime String?      @db.VarChar(160)
  comment           String?      @db.VarChar(2000)
  adPoint           String?      @db.VarChar(200)
  contactConsent    Boolean
  source            LeadSource   @default(PROMOTER)
  status            LeadStatus   @default(NEW)
  declineReason     String?      @db.VarChar(500)
  measurementAt     DateTime?
  authorId          String       @db.Uuid
  operatorId        String?      @db.Uuid
  measurerId        String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  qualifiedAt       DateTime?
  author            User         @relation("LeadAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  operator          User?        @relation("LeadOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  measurer          User?        @relation("LeadMeasurer", fields: [measurerId], references: [id], onDelete: SetNull)
  calls             CallLog[]
  tasks             WorkTask[]
  project           Project?

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([operatorId, status])
  @@map("leads")
}

model CallLog {
  id            String     @id @default(uuid()) @db.Uuid
  leadId        String     @db.Uuid
  authorId      String     @db.Uuid
  result        CallResult
  note          String?    @db.VarChar(2000)
  nextContactAt DateTime?
  calledAt      DateTime   @default(now())
  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author        User       @relation("CallAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, calledAt(sort: Desc)])
  @@index([nextContactAt])
  @@map("call_logs")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(160)
  phone           String    @db.VarChar(32)
  phoneNormalized String    @unique @db.VarChar(20)
  address         String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        Project[]

  @@map("customers")
}

model Project {
  id                String                     @id @default(uuid()) @db.Uuid
  number            String                     @unique @db.VarChar(32)
  customerId        String                     @db.Uuid
  leadId            String?                    @unique @db.Uuid
  source            LeadSource
  status            ProjectStatus              @default(QUALIFIED)
  address           String                     @db.VarChar(500)
  description       String?                    @db.VarChar(2000)
  createdById       String                     @db.Uuid
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead              Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy         User                       @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibles      ProjectResponsible[]
  tasks             WorkTask[]
  comments          ProjectComment[]
  files             ProjectFile[]
  statusHistory     ProjectStatusHistory[]
  assignmentHistory ProjectAssignmentHistory[]
  events            CalendarEvent[]
  rooms             ProjectRoom[]
  measurements      Measurement[]
  estimates         Estimate[]

  @@index([status, updatedAt])
  @@index([customerId])
  @@map("projects")
}

model WorkTask {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(300)
  description String?        @db.VarChar(2000)
  type        WorkTaskType   @default(GENERAL)
  status      WorkTaskStatus @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?
  leadId      String?        @db.Uuid
  projectId   String?        @db.Uuid
  assigneeId  String?        @db.Uuid
  authorId    String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author      User           @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([assigneeId, status, dueAt])
  @@index([leadId])
  @@index([projectId])
  @@map("work_tasks")
}

model ProjectResponsible {
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  roleLabel  String   @db.VarChar(100)
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId, roleLabel])
  @@index([userId])
  @@map("project_responsibles")
}

model ProjectComment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(3000)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_comments")
}

model ProjectFile {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  uploadedById String   @db.Uuid
  name         String   @db.VarChar(255)
  storageKey   String   @db.VarChar(500)
  mimeType     String   @db.VarChar(120)
  size         Int
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_files")
}

model ProjectStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  fromStatus  ProjectStatus?
  toStatus    ProjectStatus
  changedById String         @db.Uuid
  comment     String?        @db.VarChar(1000)
  changedAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy   User           @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt(sort: Desc)])
  @@map("project_status_history")
}

model ProjectAssignmentHistory {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  userId      String?  @db.Uuid
  roleLabel   String   @db.VarChar(100)
  action      String   @db.VarChar(32)
  changedById String   @db.Uuid
  changedAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?    @relation("AssignmentUser", fields: [userId], references: [id], onDelete: SetNull)
  changedBy   User     @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt(sort: Desc)])
  @@map("project_assignment_history")
}

model CalendarEvent {
  id         String            @id @default(uuid()) @db.Uuid
  projectId  String            @db.Uuid
  assigneeId String?           @db.Uuid
  type       CalendarEventType
  title      String            @db.VarChar(300)
  startsAt   DateTime
  endsAt     DateTime?
  note       String?           @db.VarChar(1000)
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?             @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, startsAt])
  @@index([assigneeId, startsAt])
  @@map("calendar_events")
}

model ProjectRoom {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @db.Uuid
  measurementId         String?             @db.Uuid
  name                  String              @db.VarChar(160)
  areaMode              AreaCalculationMode @default(AUTO)
  length                Decimal?            @db.Decimal(10, 2)
  width                 Decimal?            @db.Decimal(10, 2)
  area                  Decimal?            @db.Decimal(10, 2)
  perimeter             Decimal?            @db.Decimal(10, 2)
  height                Decimal?            @db.Decimal(10, 2)
  corners               Int                 @default(4)
  canvasType            String?             @db.VarChar(100)
  manufacturer          String?             @db.VarChar(120)
  color                 String?             @db.VarChar(100)
  texture               String?             @db.VarChar(100)
  profileType           String?             @db.VarChar(100)
  profileLength         Decimal?            @db.Decimal(10, 2)
  insertLength          Decimal?            @db.Decimal(10, 2)
  pipes                 Int                 @default(0)
  lights                Int                 @default(0)
  chandeliers           Int                 @default(0)
  tracks                Decimal             @default(0) @db.Decimal(10, 2)
  cornices              Decimal             @default(0) @db.Decimal(10, 2)
  niches                Decimal             @default(0) @db.Decimal(10, 2)
  ventilation           Int                 @default(0)
  sensors               Int                 @default(0)
  cabinetBypass         Decimal             @default(0) @db.Decimal(10, 2)
  additionalWorks       String?             @db.VarChar(2000)
  additionalWorkUnits   Decimal             @default(0) @db.Decimal(10, 2)
  complexityCoefficient Decimal             @default(1) @db.Decimal(6, 3)
  comment               String?             @db.VarChar(2000)
  description           String?             @db.VarChar(1000)
  sortOrder             Int                 @default(0)
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurement           Measurement?        @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  media                 ProjectRoomMedia[]
  estimateLines         EstimateLine[]

  @@index([projectId, sortOrder])
  @@index([measurementId])
  @@map("project_rooms")
}

model Measurement {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @db.Uuid
  measurerId        String            @db.Uuid
  scheduledAt       DateTime
  district          String?           @db.VarChar(160)
  objectType        String?           @db.VarChar(120)
  operatorComment   String?           @db.VarChar(2000)
  requiredDocuments String[]
  status            MeasurementStatus @default(SCHEDULED)
  startedAt         DateTime?
  draftSavedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurer          User              @relation("MeasurementMeasurer", fields: [measurerId], references: [id], onDelete: Restrict)
  rooms             ProjectRoom[]
  estimates         Estimate[]

  @@index([measurerId, scheduledAt])
  @@index([projectId, status])
  @@map("measurements")
}

model ProjectRoomMedia {
  id           String        @id @default(uuid()) @db.Uuid
  roomId       String        @db.Uuid
  uploadedById String        @db.Uuid
  type         RoomMediaType
  name         String        @db.VarChar(255)
  url          String        @db.VarChar(1000)
  createdAt    DateTime      @default(now())
  room         ProjectRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("RoomMediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([roomId, type])
  @@map("project_room_media")
}

model Tariff {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique @db.VarChar(100)
  name          String     @db.VarChar(200)
  category      String     @db.VarChar(100)
  unit          TariffUnit
  internalPrice Decimal    @db.Decimal(12, 2)
  clientPrice   Decimal    @db.Decimal(12, 2)
  metadata      Json?
  isActive      Boolean    @default(true)
  updatedById   String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  updatedBy     User?      @relation("TariffUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category, isActive])
  @@map("tariffs")
}

model Estimate {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  measurementId    String?        @db.Uuid
  version          Int
  status           EstimateStatus @default(DRAFT)
  authorId         String         @db.Uuid
  tariffSnapshot   Json
  discountPercent  Decimal        @default(0) @db.Decimal(6, 2)
  subtotalInternal Decimal        @db.Decimal(14, 2)
  subtotalClient   Decimal        @db.Decimal(14, 2)
  discountAmount   Decimal        @db.Decimal(14, 2)
  totalInternal    Decimal        @db.Decimal(14, 2)
  totalClient      Decimal        @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())
  finalizedAt      DateTime?
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurement      Measurement?   @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  author           User           @relation("EstimateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lines            EstimateLine[]

  @@unique([projectId, version])
  @@index([measurementId])
  @@map("estimates")
}

model EstimateLine {
  id                String       @id @default(uuid()) @db.Uuid
  estimateId        String       @db.Uuid
  roomId            String?      @db.Uuid
  code              String       @db.VarChar(100)
  description       String       @db.VarChar(300)
  quantity          Decimal      @db.Decimal(12, 3)
  unit              TariffUnit
  internalUnitPrice Decimal      @db.Decimal(12, 2)
  clientUnitPrice   Decimal      @db.Decimal(12, 2)
  internalAmount    Decimal      @db.Decimal(14, 2)
  clientAmount      Decimal      @db.Decimal(14, 2)
  sortOrder         Int          @default(0)
  estimate          Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  room              ProjectRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([estimateId, sortOrder])
  @@index([roomId])
  @@map("estimate_lines")
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
